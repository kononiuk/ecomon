NODE_ENV=development
PORT=3030

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ecomon

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_base64_32
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_generate_with_openssl_rand_base64_32
JWT_REFRESH_EXPIRATION=7d

# Encryption Configuration (for EcoFlow credentials)
ENCRYPTION_KEY=your_encryption_key_here_generate_with_openssl_rand_hex_32

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3030,http://localhost:3060

# EcoFlow API Configuration
ECOFLOW_API_HOST=https://api-e.ecoflow.com
ECOFLOW_POLL_INTERVAL=60000

# History & Monitor
HISTORY_RETENTION_DAYS=7
MQTT_CRED_REFRESH_INTERVAL=21600000
